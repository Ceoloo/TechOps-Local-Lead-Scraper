# Copy this file to .env and fill in your secrets. NEVER commit .env.

# Google Places API (New) key. If omitted, the scraper falls back to a
# Playwright-based Google Maps scraper (slower, best-effort).
GOOGLE_PLACES_API_KEY=

# Optional: push qualified leads to Airtable with the --sync-airtable flag.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads
