# TechOps Local Lead Scraper — environment contract. Copy to .env (never commit .env).
AION_ENVIRONMENT=development
# Airtable (live export). Leave blank to use the mock adapter / CSV only.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads
# Telemetry sink (health-aggregator base URL). Blank = local spool only.
AION_TELEMETRY_URL=
# External lead sources (respect robots/ToS). Provide via env, never hardcode.
LEAD_SOURCE_API_KEY=
